# Vercel Frontend Environment Variables
# If you use the built-in Vercel rewrites (configured in vercel.json), leave VITE_API_BASE_URL empty.
# If you want the frontend to query the Render backend directly via CORS, provide the full URL:
# VITE_API_BASE_URL=https://curse-the-code-backend.onrender.com
VITE_API_BASE_URL=
