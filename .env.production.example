# Curse the Code - Dev / Staging Deployment Environment Variables (Render Web Service)

# 1. Database Connection (Neon Cloud PostgreSQL or Render Postgres)
# Note: psycopg2 automatically supports both postgresql:// and postgres:// formats.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/curse_the_code?sslmode=require

# 2. Game Content Files (Using dev test files for development deployments)
CONTENT_FILE=content.test.json
ASSETS_DIR=assets_test

# 3. Environment & Server Port (Render automatically supplies $PORT, default is 8000)
ENVIRONMENT=development
PORT=8000

# 4. CORS Origins (Include your Vercel deployment URLs)
CORS_ORIGINS=http://localhost:5173,https://curse-the-code.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# 5. Session Cookie Security Settings
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
